# =============================================================================
# .htaccess -- WA Trolley Report
# Security, caching, and access control rules
# =============================================================================

# --- Force HTTPS (cPanel / reverse-proxy safe) ---
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Legacy brand map URLs -> consolidated map_brand.html
RewriteRule ^map_coles\.html$ map_brand.html?brand=Coles [R=302,L,QSA]
RewriteRule ^map_woolworths\.html$ map_brand.html?brand=Woolworths [R=302,L,QSA]
RewriteRule ^map_aldi\.html$ map_brand.html?brand=Aldi [R=302,L,QSA]
RewriteRule ^map_iga\.html$ map_brand.html?brand=IGA [R=302,L,QSA]
RewriteRule ^map_kmart\.html$ map_brand.html?brand=Kmart [R=302,L,QSA]
RewriteRule ^map_bigw\.html$ map_brand.html?brand=BigW [R=302,L,QSA]
RewriteRule ^map_bunnings\.html$ map_brand.html?brand=Bunnings [R=302,L,QSA]
RewriteRule ^map_spudshed\.html$ map_brand.html?brand=Spudshed [R=302,L,QSA]
RewriteRule ^map_other\.html$ map_brand.html?brand=Other [R=302,L,QSA]

# --- Block access to sensitive files ---
# Error log, rate limit data, legacy files, and this .htaccess itself
<FilesMatch "^(error_log|rate_limits\.json|lga_emails\.json|test\.html|\.htaccess|backup\.sh|trolley_data\.db|db\.php|migrate_to_sqlite\.php|migrate_20261123\.php|rotate_brand_tokens\.php|config\.local\.php|brand_tokens\.local\.json|brand_tokens\.generated\.json|api_brand_portals\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Untracked *.local.json / *.local.php on server (examples like brand_tokens.local.example.json stay public)
<FilesMatch "\.local\.(json|php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# --- Block web access to private directories (DirectoryMatch is not allowed in .htaccess on many hosts) ---
RewriteRule ^(?:geocache|backups|data|includes)(?:/|$) - [F,L]

# --- Block developer documentation from the web ---
<FilesMatch "\.md$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# --- Security Headers ---
<IfModule mod_php.c>
    php_flag expose_php Off
</IfModule>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always set Strict-Transport-Security "max-age=31536000"

    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header set X-Frame-Options "DENY"

    # XSS protection (legacy browsers)
    Header set X-XSS-Protection "1; mode=block"

    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions policy - restrict unused browser APIs
    Header set Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), geolocation=(self)"

    # Content Security Policy
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' https://*.tile.openstreetmap.org https://unpkg.com https://raw.githubusercontent.com data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'"

    # Prevent search engines indexing data pages
    <FilesMatch "\.(json)$">
        Header set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json text/html text/css application/javascript
</IfModule>

# --- Cache Control ---
<IfModule mod_headers.c>
    # Static assets: cache for 1 hour
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>

    # Data file: no cache (changes on every submission)
    <FilesMatch "trolley_logs\.json$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Mapping files: cache for 24 hours (rarely change)
    <FilesMatch "(suburb_lga_mapping|lga_contact_details)\.json$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>
